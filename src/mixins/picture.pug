mixin picture(name, alt, width, height, imgClass = '', lazy = true, sizes = '(min-width: 1280px) 360px, (min-width: 768px) 50vw, 100vw')
  picture
    source(
      type='image/avif',
      srcset=`images/${name}-400.avif 400w, images/${name}-800.avif 800w`,
      sizes=sizes
    )
    source(
      type='image/webp',
      srcset=`images/${name}-400.webp 400w, images/${name}-800.webp 800w`,
      sizes=sizes
    )
    img(
      class=imgClass,
      src=`images/${name}-800.jpg`,
      alt=alt,
      width=width,
      height=height,
      loading=lazy ? 'lazy' : false,
      fetchpriority=!lazy ? 'high' : false,
      decoding='async'
    )
